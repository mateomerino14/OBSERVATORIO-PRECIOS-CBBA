# Base de datos donde se guardan las observaciones (Supabase, Neon o local)
DATABASE_URL=postgresql://usuario:clave@localhost:5432/observatorio

# Base solo para las pruebas: se borra y se vuelve a crear en cada corrida
TEST_DATABASE_URL=postgresql://usuario:clave@localhost:5432/observatorio_pruebas

# Segundos de pausa entre pedidos a una misma tienda (mínimo 1)
PAUSA_SEGUNDOS=1.5
